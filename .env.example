# Server Configuration
HOST=0.0.0.0
PORT=8000

# Email SMTP Notification Settings (Gmail, Outlook, Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=True

# Web Push Notifications (Auto-generated on startup if left empty)
VAPID_CLAIM_EMAIL=mailto:alerts@liveforexalerts.local

# Live Market Data Providers (Optional - built-in Binance and Simulator work out of the box)
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=

# Webhook Alert Integrations (Optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
